# Banco (docker compose local)
DATABASE_URL=postgres://patch:patch@localhost:5432/patch

# Auth
BETTER_AUTH_SECRET=troque-por-um-segredo-de-32-chars
BETTER_AUTH_URL=http://localhost:3000

# E-mail (Mailpit local: UI em http://localhost:8025)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Patch <patch@localhost>"

# IA — Anthropic (triagem/geração) + Voyage (embeddings)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-3
TRIAGE_CONFIDENCE_MIN=0.55

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_PROJECT_SLUG=

# GitHub App (leitura de conteúdo + escrita de PR)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Ingestão
MAX_FILE_BYTES=524288
